<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quick Office — the Aura configuration layer.

  This is a REGISTRY OVERLAY, not a patch. It is compiled into an .xcd and
  dropped into share/registry/, where it overrides upstream defaults the same
  way LibreOffice's own main.xcd / writer.xcd do. Nothing in core/ is edited to
  achieve any of this, which is what keeps rebasing onto the next LibreOffice
  release cheap: the overlay is ours, the engine stays upstream.

  Three things are set here, and each one has a reason on the record:

    1. Tabbed UI by default    the ribbon-style layout, which is what the
                               product brief asks for ("inspired from MS Office
                               Word, Excel and PowerPoint"). Upstream ships the
                               classic toolbar as the default; every other
                               layout stays available under View > User
                               Interface, so nobody is locked in.
    2. Follow the system       Application colours default to Automatic, so the
                               apps go dark/light with the desktop — the same
                               contract every other QuickOpen app honours.
    3. Aura icons              our CC0-derived Colibre repaint (see
                               aura-icons/make-aura-icons.py).

  Plus the AIQuick product requirements that are configuration rather than
  build flags: nothing checks a remote on its own (#2 zero egress, #3 no
  auto-update), and no first-run nag screens (#10b user-friendly).

  Apache-2.0, (c) 2026 QuickOpen.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Common" oor:package="org.openoffice.Office">

  <node oor:name="Misc">
    <!-- The Aura icon set. Layered over colibre/breeze by the icon-theme
         fallback chain, so any icon we have not repainted still resolves. -->
    <prop oor:name="SymbolStyle" oor:finalized="false">
      <value>aura</value>
    </prop>
    <!-- No "you have not registered / send us data / what's new" on first run. -->
    <prop oor:name="FirstRun" oor:finalized="false">
      <value>false</value>
    </prop>
    <prop oor:name="ShowTipOfTheDay" oor:finalized="false">
      <value>false</value>
    </prop>
  </node>

  <node oor:name="Appearance">
    <!-- 0 = Automatic, follow the system light/dark setting, live.
         This is the fleet-wide rule: an app pins a theme only when the user
         explicitly asks it to. -->
    <prop oor:name="ApplicationAppearance" oor:finalized="false">
      <value>0</value>
    </prop>
  </node>

  <node oor:name="Help">
    <!-- Help stays local. Nothing reaches out to a help server. -->
    <prop oor:name="HelpTip" oor:finalized="false">
      <value>true</value>
    </prop>
  </node>

  <node oor:name="Security">
    <node oor:name="Scripting">
      <!-- Macros from documents are off by default: these apps open files that
           arrive by email. The user can still raise it in Tools > Options. -->
      <prop oor:name="MacroSecurityLevel" oor:finalized="false">
        <value>2</value>
      </prop>
    </node>
  </node>
</oor:component-data>
